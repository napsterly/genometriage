# Never commit a real key. CLI commands load this ignored file automatically.
# Default provider: Gemini. Obtain a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional comparison provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Cost remains null unless both prices are supplied explicitly.
# Prices are USD per one million tokens for the model/tier used in the run.
GENOMETRIAGE_INPUT_COST_PER_MILLION=
GENOMETRIAGE_OUTPUT_COST_PER_MILLION=
