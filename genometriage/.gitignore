.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
pytest-cache-files-*/
tests/.runtime_tmp/
.coverage
.benchmarks/
htmlcov/
build/
dist/
*.egg-info/

# Generated benchmark artifacts (keep directory placeholders).
predictions/*.json
results/*.json
predictions/*.tmp
results/*.tmp

# Retain the validated Phase 1 baseline evidence.
!predictions/baseline-gemini.json
!results/baseline-gemini.json
!predictions/evidence-grounded-v1.json
!predictions/verified-v2.json
!predictions/v0-top3-control.json
!results/baseline-gemini-phase2-replay.json
!results/evidence-grounded-v1.json
!results/verified-v2.json
!results/v0-top3-control.json
!results/phase2-comparison.json
!results/phase2-failure-analysis.json

# Retain the sealed Phase 3 V1/V3 predictions and evaluator outputs.
!predictions/conflict-arbitrated-v3.json
!predictions/benchmark_conflict_v1-evidence-grounded-v1.json
!predictions/benchmark_conflict_v1-conflict-arbitrated-v3.json
!predictions/benchmark_public_v1-evidence-grounded-v1.json
!predictions/benchmark_public_v1-conflict-arbitrated-v3.json
!results/conflict-arbitrated-v3.json
!results/benchmark_conflict_v1-evidence-grounded-v1.json
!results/benchmark_conflict_v1-conflict-arbitrated-v3.json
!results/benchmark_public_v1-evidence-grounded-v1.json
!results/benchmark_public_v1-conflict-arbitrated-v3.json
