    "mean_reciprocal_rank": "Mean reciprocal rank of the first relevant variant over positive cases; a miss or failed run scores zero, and negative controls are excluded.",
    "false_positive_count_at_k": "Count of returned variants in the first K ranks that are not evaluator-labeled relevant.",
    "unsupported_claim_rate": "Historical name for citation_traceability_error_rate. Preserved unchanged for V0 comparability.",
